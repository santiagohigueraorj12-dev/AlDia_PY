# Copia este archivo como ".env" y ajusta los valores.
PUERTO=4000

# Base de datos MariaDB (los mismos datos con los que te conectas en HeidiSQL)
DB_HOST=127.0.0.1
DB_PUERTO=3320
DB_USUARIO=root
DB_CLAVE=
DB_NOMBRE=aldia

# Clave secreta para firmar los tokens JWT (cámbiala por una cadena larga y aleatoria)
JWT_SECRETO=cambia-esta-clave-por-una-muy-larga-y-secreta
JWT_EXPIRA=8h


# --- Solo para la nube (Render + MySQL de Aiven). En local se dejan así ---
# DB_SSL=true                     # Aiven exige conexión cifrada
# DB_SSL_CA=                      # certificado "CA certificate" que entrega Aiven
# ADMIN_CORREO=admin@aldia.co
# ADMIN_CLAVE=                    # contraseña propia del administrador en internet

# --- Correos (opcional): recuperar contraseña y resumen diario de avisos ---
# Opción recomendada: Gmail por la API de Google Cloud (llega a la bandeja de entrada).
# GMAIL_CLIENT_ID=...apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=GOCSPX-...
# GMAIL_REFRESH_TOKEN=1//...
# CORREO_REMITENTE=el-gmail-que-autorizo@gmail.com
# Sin ninguno, los correos solo se escriben en la consola del backend.
# URL_APP=https://aldia-xxxx.onrender.com   (en Render no hace falta: usa RENDER_EXTERNAL_URL)

# --- Datos de demostración ---
# En producción (NODE_ENV=production) el usuario demo@aldia.co se elimina.
# DEMO=true lo mantiene.
