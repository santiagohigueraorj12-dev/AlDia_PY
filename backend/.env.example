# Copia este archivo como ".env" y ajusta los valores.
PUERTO=4000

# Base de datos MariaDB (los mismos datos con los que te conectas en HeidiSQL)
DB_HOST=127.0.0.1
DB_PUERTO=3320
DB_USUARIO=root
DB_CLAVE=
DB_NOMBRE=aldia

# Clave secreta para firmar los tokens JWT (cámbiala por una cadena larga y aleatoria)
JWT_SECRETO=cambia-esta-clave-por-una-muy-larga-y-secreta
JWT_EXPIRA=8h

